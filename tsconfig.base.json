{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sdlc/core": ["packages/core/src/index.ts"],
      "@sdlc/ui/messages": ["packages/ui/src/messages.ts"]
    },
    "types": ["node"]
  }
}
